# Discord bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=your_bot_token_here

# Your application ID (client ID). Fill this when you have it.
DISCORD_APP_ID=

# Optional: if set, slash commands are synced instantly to this guild for testing
# DISCORD_GUILD_ID=

# Optional: prefix for text commands (default is !)
# DISCORD_COMMAND_PREFIX=!

# Optional: bot interface/help language: en or vi (default is en)
# DISCORD_BOT_LANGUAGE=en
